Bootstrap: docker
# Pinned, not :latest. A floating tag means the base image's bundled Python
# and its base env's conda-meta/pinned file change out from under this build
# with no change on our side — which is exactly what broke the 2026-08-25
# build: miniforge3:latest had rolled to a base env pinned at Python 3.14,
# and libmamba choked trying to fold that pin into the solve ("Error parsing
# version '1.*^'" — a libmamba bug mangling the fuzzy pin, not anything wrong
# with the package list below). Installing into a dedicated env (see %post)
# sidesteps that pin entirely; pinning the tag here just keeps the rest of
# the base image (Ubuntu release, conda/mamba versions) from drifting too.
FROM: condaforge/miniforge3:26.1.1-3

%help
  QuantUI — Educational Quantum Chemistry Interface

  Lightweight local teaching interface for running PySCF calculations
  without a cluster. Includes PySCF, ASE, py3Dmol, and Voilà.

  Usage:
    # Clean widget UI (students see no code — recommended for class)
    apptainer run quantui.sif app

    # JupyterLab (exploration / development mode)
    apptainer run quantui.sif

  Build:
    # From the repo root:
    apptainer build quantui.sif apptainer/quantui.def

%labels
  Maintainer "Jonathan Schultz"
  Purpose "Local teaching interface for quantum chemistry calculations"
  # Deliberately not a version number: this image installs the working tree
  # (%files . /opt/quantui), so a hardcoded label here goes stale on every bump
  # and says nothing the install does not. `quantui.__version__` inside the
  # image is the authoritative answer. The GPU image pins a released version
  # instead, and a test keeps that pin in step with pyproject.
  Source "working tree at build time — see quantui.__version__ in the image"

%environment
  export PATH="/opt/conda/envs/quantui/bin:${PATH}"
  export PYTHONPATH="/opt/quantui:${PYTHONPATH}"

  # Disable user site-packages for reproducibility
  export PYTHONNOUSERSITE=1

  # Save calculation results to the user's home directory so they persist
  # across kernel restarts. The home dir is bind-mounted by Apptainer.
  export QUANTUI_RESULTS_DIR="${HOME}/.quantui/results"

%files
  # Source paths are relative to where you run `apptainer build` (repo root).
  # Run the build command from the repo root, not from apptainer/.
  #
  # An explicit allowlist, NOT `. /opt/quantui`. Copying the whole tree meant
  # copying build OUTPUT back in: with a 5.8 GB GPU image and a 6.6 GB CPU image
  # sitting in the repo root, `%files .` was hauling 13 GB into a container
  # meant to be under 1 GB. That is what actually exhausted the build tmpfs —
  # the "No space left on device" failure of 2026-08-04 — and any .sif that
  # survived the %post cleanup would have been embedded in the shipped image.
  # %files has no exclude syntax, so the list has to be positive.
  #
  # Keep in sync with what the image needs at runtime:
  #   pyproject.toml + README.md + LICENSE  -> `pip install -e .` reads all three
  #   quantui/                              -> the package (incl. vendored 3Dmol.js)
  #   notebooks/                            -> %runscript serves the Voila app
  #   tests/                                -> build.sh --test runs them in-image
  #   docs/                                 -> user-facing guides referenced by help
  pyproject.toml /opt/quantui/
  README.md /opt/quantui/
  LICENSE /opt/quantui/
  MANIFEST.in /opt/quantui/
  CHANGELOG.md /opt/quantui/
  quantui /opt/quantui/
  notebooks /opt/quantui/
  tests /opt/quantui/
  docs /opt/quantui/

%post
  export PATH="/opt/conda/bin:${PATH}"

  echo "Creating a dedicated 'quantui' env pinned to Python 3.11 ────────────"
  # NOT installed into base. Two reasons:
  #  1. base's Python floats with whatever the miniforge3 image tag bundles
  #     (see the FROM comment) and inherits that env's own conda-meta/pinned
  #     file — which is what produced the libmamba "1.*^" parse crash here.
  #  2. This project's tested/supported matrix is Python 3.9-3.11 (see
  #     CLAUDE.md and .github/workflows/ci.yml); base's bundled Python is
  #     whatever the image happens to ship, with no guarantee it's in range.
  # A fresh named env sidesteps both — it gets its own clean pin state and an
  # explicit interpreter version.
  echo "Installing dependencies via mamba (libmamba solver — the old classic conda solver hangs for hours on this pyscf + rdkit + jupyterlab spec)."
  # conda-forge only, strict priority: avoids mixing in the base image's
  # implicit 'defaults' channel, which both slows the solve and pulls from a
  # channel with separate terms of service.
  conda config --system --set channel_priority strict
  mamba create -y -n quantui --override-channels -c conda-forge \
    python=3.11 \
    jupyter \
    jupyterlab \
    ipywidgets \
    notebook \
    pyscf \
    numpy \
    scipy \
    matplotlib \
    plotly \
    h5py \
    rdkit

  export PATH="/opt/conda/envs/quantui/bin:${PATH}"

  echo "Installing pip packages..."
  pip install --no-cache-dir \
    voila \
    ase \
    py3dmol \
    requests

  echo "Installing QuantUI..."
  cd /opt/quantui
  pip install --no-cache-dir -e .

  echo "Verifying installation..."
  python -c "import quantui; print('QuantUI OK')"
  python -c "import pyscf; print('PySCF OK')"
  python -c "import rdkit; print('RDKit OK')"
  python -c "import py3Dmol; print('py3Dmol OK')"
  # Offline 3D: the vendored 3Dmol.js must be bundled and make_view must emit a
  # CDN-free viewer that loads it from a local data: URI, or every 3D view
  # blanks with no network (the whole point of the offline build). Fail the
  # build here rather than ship blank viewers.
  python -c "from quantui.viz_assets import _JS_PATH, _js_data_uri, make_view; assert _JS_PATH.exists() and _JS_PATH.stat().st_size > 100000, 'vendored 3Dmol.js missing/too small'; assert _js_data_uri().startswith('data:text/javascript;base64,'); v = make_view(width=80, height=80); v.addModel('1\nH\nH 0 0 0', 'xyz'); h = v._make_html(); assert 'jsdelivr' not in h and 'data:text/javascript;base64,' in h, 'viewer not loading vendored 3Dmol offline'; print('offline 3Dmol OK')"
  python -c "import ase; print('ASE OK')"
  python -c "from quantui import optimize_geometry; print('optimize_geometry OK')"
  python -c "from quantui import run_freq_calc, run_tddft_calc; print('freq/tddft OK')"
  python -c "from quantui.app import QuantUIApp; print('QuantUIApp OK')"

  echo "Cleaning up unnecessary files..."
  # Only what the BUILD itself can create. The long list that used to live here
  # — .git, CLAUDE.md, planning/, .github, dev launchers — existed to undo
  # `%files .`; with an allowlist those can no longer arrive, and deleting
  # things that are never copied just hides what is really in the image.
  # A .sif can no longer be copied in either, which was the expensive one.
  find /opt/quantui -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
  find /opt/quantui -name "*.egg-info" -exec rm -rf {} + 2>/dev/null || true
  rm -rf /opt/quantui/.pytest_cache

  echo "Configuring Jupyter Server..."
  mkdir -p /etc/jupyter
  cat > /etc/jupyter/jupyter_server_config.py << 'EOF'
# Disable XSRF cookie checks — prevents 403 errors on kernel shutdown in Voilà.
c.ServerApp.disable_check_xsrf = True
EOF

  conda clean --all -y
  pip cache purge

  echo "Build complete!"

%runscript
  MODE="${1:-lab}"
  shift 2>/dev/null || true
  if [ "$MODE" = "app" ]; then
    exec voila /opt/quantui/notebooks/molecule_computations.ipynb \
         --no-browser --port=8866 "${@}"
  else
    exec jupyter lab --ip=0.0.0.0 --no-browser --allow-root "${@}"
  fi

%test
  echo "Testing container..."
  python -c "import quantui" || exit 1
  python -c "import pyscf" || exit 1
  python -c "import py3Dmol" || exit 1
  python -c "import ase" || exit 1
  python -c "from quantui import Molecule; print('Molecule OK')" || exit 1
  python -c "from quantui.app import QuantUIApp; print('QuantUIApp OK')" || exit 1
  echo "All tests passed!"
