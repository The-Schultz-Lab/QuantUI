# Dev launcher stamp (written by launchers/launch-native.* to skip redundant pip install)
.dev_install_stamp

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Local config (user-specific overrides — never commit)
config.local.py


# Calculation output files
*.npz
*.out
*.err
results/

# Test / coverage output
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# Mypy
.mypy_cache/

# Apptainer build artefacts
*.sif
*.sandbox/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# MkDocs build output
site/

planning/
nul
/temp - untracked/
/logs
.claudeignore
.apptainer-build-tmp/
quantui-gpu.sif
